<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime blocks audio input without this. Process taps are
         audio input from the system's point of view; keep it unless a signed
         build proves taps work without it. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
